# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 运行时数据（全部自动生成，不入库）
#   data/rnts.db      论文数据库
#   data/reports/     每日生成的报告
#   data/attachments/ 收藏夹上传的 PDF
#   data/cache/       抓取缓存
data/
*.log
*.db
*.sqlite3

# sort_config.py 生成的配置备份（可能含本机路径）
config/*.bak
config/config.yaml.bak

# 个人配置：关键词 / 关注作者 / 云盘目录，每人一份，不入库。
# 仓库里只跟踪模板 config/config.example.yaml（程序缺文件时会自动复制一份）。
config/config.yaml

# 环境 / 密钥
.env
.env.*

# OS / 编辑器
.DS_Store
Thumbs.db
.idea/
.vscode/

# 本机专属（发布 zip、本地备份、工具会话产物）
*.zip
_backup_pre_v101/
.zcode/
make_release.py
tools/
